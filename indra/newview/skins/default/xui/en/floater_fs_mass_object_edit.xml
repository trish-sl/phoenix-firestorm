<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 can_close="true"
 can_minimize="true"
 height="650"
 layout="topleft"
 min_height="500"
 min_width="760"
 name="mass_object_edit"
 title="Mass Object Edit"
 width="940">
    <text left="12" top="28" width="430" height="20" name="targets_label">Targets (current-region prims)</text>
    <button left="12" top="50" width="90" height="24" name="refresh_btn" label="Refresh" />
    <button left_pad="8" width="150" height="24" name="scan_contents_btn" label="Scan Target Contents" />
    <scroll_list
     left="12" top="82" width="446" height="500"
     name="target_list" multi_select="true">
        <scroll_list.columns name="name" label="Object / link" width="250" />
        <scroll_list.columns name="owner" label="Owner" width="180" />
    </scroll_list>

    <button left="474" top="28" width="180" height="24" name="use_source_btn" label="Use Selected Prim as Source" />
    <text left="664" top="32" width="260" height="20" name="source_label">No source selected</text>
    <text left="474" top="62" width="450" height="20" name="source_contents_label">Source Contents (select items to add or replace)</text>
    <scroll_list
     left="474" top="84" width="450" height="205"
     name="source_list" multi_select="true">
        <scroll_list.columns name="name" label="Name" width="275" />
        <scroll_list.columns name="type" label="Type" width="105" />
        <scroll_list.columns name="permissions" label="Copy" width="50" />
    </scroll_list>

    <text left="474" top="300" width="450" height="20" name="target_contents_label">Aggregated Target Contents (select arbitrary items to delete)</text>
    <scroll_list
     left="474" top="322" width="450" height="260"
     name="target_contents_list" multi_select="true">
        <scroll_list.columns name="name" label="Name" width="255" />
        <scroll_list.columns name="type" label="Type" width="105" />
        <scroll_list.columns name="count" label="Targets" width="70" />
    </scroll_list>

    <button left="474" top="592" width="100" height="26" name="add_btn" label="Add" />
    <button left_pad="8" width="100" height="26" name="replace_btn" label="Replace" />
    <button left_pad="8" width="100" height="26" name="delete_btn" label="Delete" />
    <text left="12" top="606" width="440" height="34" name="status_text" word_wrap="true">Ready.</text>
</floater>
