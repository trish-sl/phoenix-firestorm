    <string name="language_lua">Lua</string>
    <scroll_list
     name="repos"
     layout="topleft"
     follows="left|right|top"
     left="8"
     right="-8"
     top="6"
     height="84"
     draw_heading="true"
     multi_select="false">
        <scroll_list.columns name="repo" label="Repository" relative_width="0.4" />
        <scroll_list.columns name="branch" label="Branch" relative_width="0.25" />
        <scroll_list.columns name="synced" label="Last sync" relative_width="0.35" />
    </scroll_list>
    <line_editor
     name="repo_edit"
     label="owner/repo or GitHub link"
     layout="topleft"
     follows="left|right|top"
     left="8"
     right="-246"
     top="96"
     height="22" />
    <line_editor
     name="branch_edit"
     label="branch (optional)"
     layout="topleft"
     follows="right|top"
     left_pad="4"
     width="120"
     height="22" />
    <button
     name="add"
     label="Add"
     layout="topleft"
     follows="right|top"
     left_pad="4"
     width="54"
     height="22" />
    <button
     name="remove"
     label="Remove"
     layout="topleft"
     follows="right|top"
     left_pad="4"
     width="60"
     height="22" />
    <check_box
     name="images"
     label="Also upload images (L$)"
     tool_tip="PNG, JPEG and TGA files become textures. Each upload costs L$; the total is shown before you apply."
     layout="topleft"
     follows="left|top"
     left="8"
     top="126"
     height="20"
     width="170" />
    <text
     name="prefix_label"
     layout="topleft"
     follows="left|top"
     left_pad="4"
     height="20"
     width="44">Prefix:</text>
    <line_editor
     name="prefix_edit"
     max_length_bytes="16"
     tool_tip="Put in front of each repository's folder name in Scripts, for sorting. Example: ! puts the folders at the top. Changing it renames the folders."
     layout="topleft"
     follows="left|top"
     left_pad="0"
     width="36"
     height="22" />
    <text
     name="ignore_label"
     layout="topleft"
     follows="left|top"
     left_pad="4"
     height="20"
     width="44">Ignore:</text>
    <line_editor
     name="ignore_edit"
     tool_tip="Files to leave out, comma separated. * matches anything, folders included. Example: *.test.*, */original/*"
     layout="topleft"
     follows="left|right|top"
     left_pad="0"
     right="-282"
     height="22" />
    <text
     name="token_label"
     layout="topleft"
     follows="right|top"
     left_pad="6"
     height="20"
     width="48">Token:</text>
    <line_editor
     name="token_edit"
     is_password="true"
     tool_tip="A GitHub fine-grained token with read-only Contents access to these repositories. Kept in the viewer's protected store, only sent to api.github.com."
     layout="topleft"
     follows="right|top"
     left_pad="0"
     width="166"
     height="22" />
    <button
     name="forget"
     label="Forget"
     layout="topleft"
     follows="right|top"
     left_pad="4"
     width="56"
     height="22" />
    <button
     name="check"
     label="Check for changes"
     tool_tip="Compares the repositories with the Scripts folder. Changes nothing."
     layout="topleft"
     follows="left|top"
     left="8"
     top="156"
     width="140"
     height="22" />
    <button
     name="check_region"
     label="Check scripts in this region"
     tool_tip="Finds scripts in your own objects in this region with the name of a repository script. Changes nothing."
     layout="topleft"
     follows="left|top"
     left_pad="4"
     width="190"
     height="22" />
    <scroll_list
     name="results"
     layout="topleft"
     follows="all"
     left="8"
     right="-8"
     top="186"
     bottom="-56"
     draw_heading="true"
     multi_select="false">
        <scroll_list.columns name="action" label="Action" width="90" />
        <scroll_list.columns name="what" label="Item" relative_width="0.5" />
        <scroll_list.columns name="kind" label="Kind" width="96" />
        <scroll_list.columns name="note" label="Note" relative_width="0.5" />
    </scroll_list>
    <text
     name="status"
     layout="topleft"
     follows="left|right|bottom"
     left="8"
     right="-8"
     bottom="-34"
     height="18"
     word_wrap="false"
     use_ellipses="true" />
    <progress_bar
     name="progress"
     layout="topleft"
     follows="left|right|bottom"
     left="8"
     right="-150"
     bottom="-10"
     height="16" />
    <button
     name="apply"
     label="Apply"
     layout="topleft"
     follows="right|bottom"
     right="-74"
     bottom="-6"
     width="66"
     height="22" />
    <button
     name="cancel"
     label="Cancel"
     layout="topleft"
     follows="right|bottom"
     right="-8"
     bottom="-6"
     width="62"
     height="22" />
</floater>
